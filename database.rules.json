{
  "rules": {
    ".read": false,
    ".write": false,
    "salas": {
      "$sala": {
        ".read": true,
        "estado": { ".write": true },
        "gente": {
          ".write": true,
          "$id": { ".validate": "newData.hasChildren(['a'])" }
        },
        "votos": {
          ".write": true,
          "$q": { "$id": { ".validate": "newData.hasChildren(['v'])" } }
        }
      }
    }
  }
}
